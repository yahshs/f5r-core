NODE_ENV=production
PORT=8787
BASE_PUBLIC_URL=https://your-app.example.com
DB_PATH=/data/app.sqlite
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=v1
# Previous keys needed for rotation and restoring older backups:
ENCRYPTION_KEYS_JSON={}
TRUST_PROXY_HOPS=0
WORKERS_ENABLED=0
OUTBOUND_CONCURRENCY=8
MONITORING_TOKEN=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_STATE_SECRET=
SALLA_REDIRECT_URI=https://your-app.example.com/api/integrations/salla/callback
SALLA_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Only set for the explicit npm run admin:bootstrap command; remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
